# Enable 256 colors
set -g default-terminal "tmux-256color"

# Mouse support
set -g mouse on

# Faster key repeat
set -sg repeat-time 0

# Set default shell
set-option -g default-shell "/bin/zsh"

# Reload config
unbind r
bind r source-file ~/.tmux.conf \; display "Reloaded!"

# Session management
bind C new-session -s "" -c "#{pane_current_path}"
bind C last-session

# Better copy mode
set -g default-command "reattach-to-user-namespace -l /bin/zsh" 2>/dev/null || true
bind-key -n M-C copy-mode
bind-key -n M-v paste-buffer